<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <!-- 顶部条 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/row_h"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/margin_h"
        android:paddingEnd="@dimen/margin_h">

        <TextView
            android:id="@+id/btn_back"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:paddingEnd="@dimen/margin_h"
            android:text="← 首页"
            android:textColor="@color/accent"
            android:textSize="@dimen/text_body" />

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:lineSpacingMultiplier="1.5"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_title" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider" />

    <!-- 随机一题：一行通栏按钮（前端设计 §2） -->
    <Button
        android:id="@+id/btn_random"
        style="@style/Button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_h"
        android:layout_marginTop="@dimen/margin_h"
        android:layout_marginEnd="@dimen/margin_h"
        android:text="@string/random" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/margin_h"
        android:paddingTop="@dimen/gap_row"
        android:paddingEnd="@dimen/margin_h"
        android:text="@string/list_hint"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/text_secondary" />

    <!-- 题目列表：顺序 = bank.json 数组顺序，不重排（前端设计 §2） -->
    <ListView
        android:id="@+id/list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/margin_h"
        android:layout_weight="1"
        android:divider="@color/divider"
        android:dividerHeight="1dp" />

    <!-- 该级题库为空（前端设计 §8） -->
    <TextView
        android:id="@+id/tv_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="@string/empty_level"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/text_body"
        android:visibility="gone" />

</LinearLayout>
