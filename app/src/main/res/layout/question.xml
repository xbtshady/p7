<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <!-- 顶部条：题号 · 辅助档 ｜ 退出 + 倒计时（挑战档） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/row_h"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/margin_h"
        android:paddingEnd="@dimen/margin_h">

        <TextView
            android:id="@+id/tv_top"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_body" />

        <TextView
            android:id="@+id/tv_timer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingEnd="@dimen/margin_h"
            android:text="01:30"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_body"
            android:visibility="gone" />

        <TextView
            android:id="@+id/btn_exit"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:text="@string/exit"
            android:textColor="@color/accent"
            android:textSize="@dimen/text_body" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider" />

    <!-- 页面整体可滚动，答案区不单独滚动（前端设计 §8） -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/margin_h"
            android:paddingTop="@dimen/margin_h"
            android:paddingEnd="@dimen/margin_h"
            android:paddingBottom="@dimen/margin_h">

            <!-- 题面区 -->
            <LinearLayout
                android:id="@+id/box_prompt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- 第一步输入区（仅挑战档） -->
            <LinearLayout
                android:id="@+id/box_first_step"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_block"
                android:orientation="vertical"
                android:visibility="gone" />

            <!-- 作答区 -->
            <LinearLayout
                android:id="@+id/box_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_block"
                android:orientation="vertical" />

            <Button
                android:id="@+id/btn_submit"
                style="@style/Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_h"
                android:text="@string/submit"
                android:visibility="gone" />

            <!-- 结果 + 答案区：提交后展开 -->
            <LinearLayout
                android:id="@+id/box_result"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_block"
                android:orientation="vertical"
                android:visibility="gone" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
