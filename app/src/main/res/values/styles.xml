<resources>
    <!-- 浅色固定。用 Light 主题且不引 DayNight -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowBackground">@color/background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@color/background</item>
        <!-- API 35+ 对 targetSdk 35+ 强制 edge-to-edge，内容会被状态栏盖住。
             p7 是全屏单栏布局，没有做系统栏适配，先按旧行为处理。 -->
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
    </style>

    <!-- 顶部条：白底 + 底部描边 -->
    <style name="TopBar">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/row_h</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingStart">@dimen/margin_h</item>
        <item name="android:paddingEnd">@dimen/margin_h</item>
    </style>

    <!-- 前端设计文档 §7：按钮高 48dp、圆角 8dp -->
    <style name="Button" parent="Widget.AppCompat.Button">
        <item name="android:minHeight">@dimen/button_h</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:background">@drawable/bg_button</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- 次要按钮：描边 + 正文色，用于重做、开始作答 -->
    <style name="Button.Secondary" parent="Widget.AppCompat.Button">
        <item name="android:minHeight">@dimen/button_h</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:background">@drawable/bg_button_secondary</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
</resources>
